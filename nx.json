{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/.oxlintrc.jsonc",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/jestGlobalExtendExpectImport.[jt]s",
      "!{projectRoot}/jestAfterEnvSetup.[jt]s",
      "!{projectRoot}/jestSetup.[jt]s",
      "!{projectRoot}/jestGlobalSetup.[jt]s"
    ],
    "sharedGlobals": [],
    "typecheck": [
      "{projectRoot}/tsconfig.json",
      "{projectRoot}/**/*.ts",
      "{projectRoot}/**/*.tsx",
      "{projectRoot}/**/*.d.ts",
      "{projectRoot}/locales/**/*.json",
      "!{projectRoot}/android/**",
      "!{projectRoot}/ios/**",
      "!{projectRoot}/coverage/**",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/**/Pods/**",
      { "externalDependencies": ["typescript"] }
    ]
  },
  "targetDefaults": {
    "oxlint": {
      "options": {
        "args": "--type-aware --report-unused-disable-directives-severity=warn"
      }
    },
    "test": {
      "configurations": {
        "ci": {
          "ci": true
        }
      }
    },
    "tsc-noemit": {
      "cache": true,
      "inputs": ["typecheck"],
      "outputs": []
    }
  },
  "release": {
    "groups": {
      "main-app": {
        "projects": ["main-app"],
        "projectsRelationship": "fixed",
        "version": {
          "specifierSource": "prompt",
          "conventionalCommits": false,
          "updateDependents": "never"
        },
        "releaseTag": {
          "pattern": "{version}",
          "checkAllBranchesWhen": true,
          "strictPreid": true
        },
        "changelog": {
          "createRelease": false
        }
      },
      "design-system": {
        "projects": ["io-app-design-system"],
        "projectsRelationship": "fixed",
        "version": {
          "specifierSource": "prompt",
          "conventionalCommits": false,
          "updateDependents": "never"
        },
        "releaseTag": {
          "pattern": "design-system-v{version}",
          "checkAllBranchesWhen": true,
          "strictPreid": true
        },
        "changelog": {
          "createRelease": "github"
        }
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": true
    },
    "conventionalCommits": {
      "types": {
        "feat": {
          "semverBump": "minor",
          "changelog": {
            "title": "Features"
          }
        },
        "fix": {
          "semverBump": "patch",
          "changelog": {
            "title": "Bug Fixes"
          }
        },
        "chore": {
          "semverBump": "none",
          "changelog": {
            "title": "Chores"
          }
        },
        "docs": {
          "semverBump": "none",
          "changelog": {
            "hidden": true
          }
        },
        "style": {
          "semverBump": "none",
          "changelog": {
            "hidden": true
          }
        },
        "refactor": {
          "semverBump": "none",
          "changelog": {
            "hidden": true
          }
        },
        "perf": {
          "semverBump": "none",
          "changelog": {
            "hidden": true
          }
        },
        "test": {
          "semverBump": "none",
          "changelog": {
            "hidden": true
          }
        }
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "oxlint"
      }
    }
  ]
}
