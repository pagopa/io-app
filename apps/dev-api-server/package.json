{
  "name": "@io-app/dev-api-server",
  "pretty_name": "IO App - dev server",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon",
    "test": "jest",
    "test-watch": "jest --watch",
    "test:ci": "jest --ci --maxWorkers=2 --silent",
    "test:dev": "jest --detectOpenHandles --coverage=false",
    "validate": "pnpm run lint && pnpm run test:ci && pnpm run tsc-noemit",
    "lint-autofix": "oxlint . --fix",
    "start": "ts-node src/start.ts",
    "knip": "pnpm --dir ../.. knip",
    "tsc-noemit": "tsc --noEmit"
  },
  "jest": {
    "preset": "ts-jest",
    "collectCoverage": false,
    "moduleNameMapper": {
      "^axios$": "axios/dist/node/axios.cjs"
    }
  },
  "dependencies": {
    "@mattrglobal/http-signatures": "^4.0.1",
    "@io-app/api-types": "workspace:*",
    "@pagopa/ts-commons": "^10.15.0",
    "axios": "^1.10.0",
    "body-parser": "^1.19.2",
    "chalk": "^4.1.1",
    "cli-ux": "^5.6.3",
    "compare-versions": "^6.0.0-rc.1",
    "cookie-parser": "^1.4.6",
    "date-fns": "^2.27.0",
    "escape-html": "^1.0.3",
    "express": "^4.21.2",
    "figlet": "^1.5.2",
    "fp-ts": "^2.16.9",
    "io-ts": "^2.2.22",
    "jose": "^4.15.5",
    "jsontokens": "^4.0.1",
    "lodash": "^4.17.21",
    "morgan": "^1.10.1",
    "qs": "^6.15.3",
    "sha256": "^0.2.0",
    "ts-pattern": "^3.3.4",
    "ulid": "^2.3.0",
    "uuid": "^9.0.1",
    "xml2js": "^0.5.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/body-parser": "^1.19.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^4.17.21",
    "@types/jest": "catalog:",
    "@types/lodash": "^4.14.178",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.32",
    "@types/sha256": "^0.2.0",
    "@types/supertest": "^2.0.8",
    "@types/uuid": "^9.0.8",
    "@types/xml2js": "^0.4.11",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "jest": "catalog:",
    "nodemon": "^2.0.15",
    "supertest": "^6.2.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.4.0",
    "typescript": "catalog:"
  }
}
