{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  // Patterns are "**/"-anchored so they also match when this config is reached
  // through `extends` from another project (design-system, dev-api-server).
  "ignorePatterns": [
    "**/*.js",
    "**/*.cjs",
    "**/*.mjs",
    "**/locales/locales.ts",
    "**/definitions/**",
    "**/*.typegen.ts"
  ],
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      "rules": {
        "constructor-super": "error",
        "for-direction": "error",
        "no-async-promise-executor": "error",
        "no-case-declarations": "off",
        "no-class-assign": "error",
        "no-compare-neg-zero": "error",
        "no-cond-assign": "warn",
        "no-const-assign": "error",
        "no-constant-binary-expression": "error",
        "no-constant-condition": "off",
        "no-control-regex": "warn",
        "no-debugger": "warn",
        "no-delete-var": "warn",
        "no-dupe-class-members": "error",
        "no-dupe-else-if": "error",
        "no-dupe-keys": "error",
        "no-duplicate-case": "error",
        "no-empty": "off",
        "no-empty-character-class": "warn",
        "no-empty-pattern": "error",
        "no-empty-static-block": "error",
        "no-ex-assign": "warn",
        "no-extra-boolean-cast": "warn",
        "no-fallthrough": "warn",
        "no-func-assign": "warn",
        "no-global-assign": "error",
        "no-import-assign": "error",
        "no-invalid-regexp": "warn",
        "no-irregular-whitespace": "error",
        "no-loss-of-precision": "error",
        "no-misleading-character-class": "error",
        "no-new-native-nonconstructor": "error",
        "no-nonoctal-decimal-escape": "error",
        "no-obj-calls": "warn",
        "no-prototype-builtins": "error",
        "no-redeclare": "off",
        "no-regex-spaces": "warn",
        "no-self-assign": "error",
        "no-setter-return": "error",
        "no-shadow-restricted-names": "warn",
        "no-sparse-arrays": "warn",
        "no-this-before-super": "error",
        "no-unassigned-vars": "error",
        "no-unexpected-multiline": "off",
        "no-unsafe-finally": "error",
        "no-unsafe-negation": "error",
        "no-unsafe-optional-chaining": "error",
        "no-unused-labels": "error",
        "no-unused-private-class-members": "error",
        // Allow `_`-prefixed throwaways and rest-sibling destructuring omits,
        // matching tsc's noUnusedLocals.
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "ignoreRestSiblings": true
          }
        ],
        // Disabled for test files below, where empty stubs are common.
        "no-empty-function": "error",
        "no-useless-backreference": "error",
        "no-useless-catch": "error",
        "no-useless-escape": "warn",
        "no-with": "warn",
        "preserve-caught-error": "error",
        "require-yield": "error",
        "use-isnan": "warn",
        "valid-typeof": "warn",
        "no-array-constructor": "warn",
        "no-unused-expressions": ["error"],
        "typescript/ban-ts-comment": "error",
        "typescript/no-duplicate-enum-values": "error",
        "typescript/no-empty-object-type": "error",
        "typescript/no-explicit-any": "off",
        "typescript/no-extra-non-null-assertion": "error",
        "typescript/no-misused-new": "error",
        "typescript/no-namespace": "error",
        "typescript/no-non-null-asserted-optional-chain": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/no-require-imports": [
          "error",
          {
            "allow": [
              "\\.png$",
              "\\.jpg$",
              "\\.jpeg$",
              "\\.gif$",
              "\\.svg",
              "\\.webp$"
            ]
          }
        ],
        "typescript/no-this-alias": "error",
        "typescript/no-unnecessary-type-constraint": "error",
        "typescript/no-unsafe-declaration-merging": "error",
        "typescript/no-unsafe-function-type": "error",
        "typescript/no-wrapper-object-types": "error",
        "typescript/prefer-as-const": "error",
        "typescript/prefer-namespace-keyword": "error",
        "typescript/triple-slash-reference": "error",
        "curly": "error",
        "unicode-bom": "off",
        "unicorn/empty-brace-spaces": "off",
        "unicorn/no-nested-ternary": "off",
        "unicorn/number-literal-case": "off",
        "no-console": "error",
        "no-inner-declarations": "off",
        "block-scoped-var": "off",
        "complexity": "error",
        "default-case": "off",
        "eqeqeq": ["error", "smart"],
        "guard-for-in": "error",
        "no-alert": "warn",
        "no-caller": "error",
        "no-div-regex": "warn",
        "no-else-return": "off",
        "no-eq-null": "off",
        "no-eval": "error",
        "no-extend-native": "warn",
        "no-extra-bind": "warn",
        "no-labels": "warn",
        "no-iterator": "warn",
        "no-lone-blocks": "warn",
        "no-loop-func": "off",
        "no-multi-str": "off",
        "no-new": "warn",
        "no-new-func": "error",
        "no-new-wrappers": "error",
        "no-proto": "warn",
        "no-return-assign": "warn",
        "no-script-url": "warn",
        "no-self-compare": "warn",
        "no-sequences": "warn",
        "no-void": "off",
        "no-warning-comments": "off",
        "radix": "error",
        "vars-on-top": "off",
        "yoda": "warn",
        "no-label-var": "warn",
        "no-shadow": "warn",
        "no-undefined": "off",
        "no-use-before-define": "off",
        "object-shorthand": "error",
        "no-underscore-dangle": [
          "error",
          {
            "allow": [
              "_persist", // redux-persist internal state key
              "_tag", // io-ts tagged union discriminant
              "_type", // io-ts tagged union discriminant
              "_links", // HAL REST convention
              "__REDUX_DEVTOOLS_EXTENSION_COMPOSE__" // Redux DevTools global
            ]
          }
        ],
        "func-names": "off",
        "func-style": "off",
        "new-cap": "off",
        "no-nested-ternary": "off",
        "no-lonely-if": "off",
        "no-ternary": "off",
        "sort-vars": "off",
        "max-nested-callbacks": "off",
        "max-depth": "off",
        "max-params": "off",
        "max-statements": "off",
        "no-bitwise": "error",
        "no-plusplus": "off",
        "react/display-name": "off",
        "react/jsx-boolean-value": "off",
        "react/jsx-no-comment-textnodes": "error",
        "react/jsx-no-duplicate-props": "error",
        "react/jsx-no-undef": "error",
        "react/no-did-mount-set-state": "warn",
        "react/no-multi-comp": "off",
        "react/no-string-refs": "error",
        "react/no-unknown-property": "off",
        "react/react-in-jsx-scope": "off",
        "react/self-closing-comp": "warn",
        "jest/no-disabled-tests": "warn",
        "jest/no-focused-tests": "warn",
        "jest/no-identical-title": "warn",
        "jest/valid-expect": "warn",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "prefer-const": "error",
        "no-var": "error",
        "no-param-reassign": "error",
        "no-throw-literal": "error",
        "no-duplicate-imports": "error",
        "arrow-body-style": "error",
        "react/jsx-key": "error",
        "react/jsx-no-constructed-context-values": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "i18n-js",
                "message": "Importing I18n from \"i18n-js\" is not allowed. Import it from \"ts/i18n.ts\" instead."
              },
              {
                "name": "@pagopa/ts-commons",
                "importNames": ["pot"],
                "message": "Importing { pot } from \"@pagopa/ts-commons\" is not allowed. Use 'import * as pot from \"@pagopa/ts-commons/lib/pot\"' instead."
              },
              {
                "name": "redux-saga/effects",
                "message": "Importing from \"redux-saga/effects\" is not allowed. Use \"typed-redux-saga/macro\" instead for type-safe saga effects."
              }
            ],
            // Consumers must use the public design-system API instead of its monorepo path or internals
            "patterns": [
              {
                "group": [
                  "**/libs/design-system/**", // Avoid monorepo path
                  "@io-app/design-system/**" // Avoid internals
                ],
                "message": "Import from \"@io-app/design-system\" to use the design system."
              }
            ]
          }
        ],
        "typescript/explicit-module-boundary-types": "off",
        "typescript/no-inferrable-types": "error",
        "typescript/array-type": [
          "error",
          {
            "default": "generic"
          }
        ],
        "typescript/await-thenable": "error",
        "typescript/consistent-type-assertions": "error",
        "typescript/no-dynamic-delete": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-misused-promises": "error",
        "typescript/prefer-function-type": "error",
        "typescript/restrict-plus-operands": "error",
        "typescript/strict-boolean-expressions": [
          "warn",
          {
            "allowNullableBoolean": true,
            "allowNullableString": true
          }
        ],
        "typescript/unified-signatures": "error"
      },
      "plugins": ["typescript", "unicorn", "react", "jest"],
      "env": {
        "es2026": true
      },
      "globals": {
        "__DEV__": "writable",
        "__dirname": "readonly",
        "__fbBatchedBridgeConfig": "readonly",
        "AbortController": "readonly",
        "Blob": "writable",
        "alert": "readonly",
        "cancelAnimationFrame": "readonly",
        "cancelIdleCallback": "readonly",
        "clearImmediate": "writable",
        "clearInterval": "readonly",
        "clearTimeout": "readonly",
        "console": "readonly",
        "document": "readonly",
        "ErrorUtils": "readonly",
        "Event": "readonly",
        "EventTarget": "readonly",
        "exports": "readonly",
        "fetch": "readonly",
        "File": "writable",
        "FileReader": "readonly",
        "FormData": "readonly",
        "global": "readonly",
        "Headers": "readonly",
        "Map": "writable",
        "module": "readonly",
        "navigator": "readonly",
        "process": "readonly",
        "Promise": "writable",
        "requestAnimationFrame": "writable",
        "requestIdleCallback": "writable",
        "require": "readonly",
        "Set": "writable",
        "setImmediate": "writable",
        "setInterval": "readonly",
        "setTimeout": "readonly",
        "queueMicrotask": "writable",
        "URL": "readonly",
        "URLSearchParams": "readonly",
        "WebSocket": "writable",
        "window": "readonly",
        "XMLHttpRequest": "readonly"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}"],
      "rules": {
        // Tests may use the restricted `paths`, but not design-system internals
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/libs/design-system/**", // Avoid monorepo path
                  "@io-app/design-system/**" // Avoid internals
                ],
                "message": "Import from \"@io-app/design-system\" to use the design system."
              }
            ]
          }
        ],
        "no-shadow": "off",
        "no-empty-function": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-require-imports": "off",
        "typescript/unbound-method": "off",
        "typescript/no-misused-spread": "off",
        "react/jsx-no-constructed-context-values": "off"
      },
      "plugins": ["typescript", "react"]
    },
    {
      // Data-driven tests derive titles dynamically (loop variables, `fn.name`,
      // ternaries), and saga tests assert through redux-saga-test-plan's
      // chainable APIs rather than a bare `expect`. The trailing assert helpers
      // hold the assertions for a parameterised suite.
      "files": ["**/*.test.{ts,tsx}", "**/__tests__/**/*.{ts,tsx}"],
      "rules": {
        // Mirrors @pagopa/eslint-config/jest, which master applies to test files
        "jest/no-alias-methods": "error",
        "jest/no-commented-out-tests": "warn",
        "jest/no-deprecated-functions": "error",
        "jest/no-done-callback": "error",
        "jest/no-export": "error",
        "jest/no-focused-tests": "error",
        "jest/no-identical-title": "error",
        "jest/no-interpolation-in-snapshots": "error",
        "jest/no-jasmine-globals": "error",
        "jest/no-standalone-expect": "error",
        "jest/no-test-prefixes": "error",
        "jest/prefer-equality-matcher": "error",
        "jest/prefer-expect-resolves": "error",
        "jest/prefer-spy-on": "error",
        "jest/prefer-todo": "error",
        "jest/valid-describe-callback": "error",
        "jest/valid-expect": "error",
        "jest/valid-expect-in-promise": "error",
        "jest/valid-title": [
          "error",
          {
            "ignoreTypeOfDescribeName": true,
            "ignoreTypeOfTestName": true
          }
        ],
        "jest/expect-expect": [
          "warn",
          {
            "assertFunctionNames": [
              "expect",
              "expectSaga",
              "testSaga",
              "commonAccessibilityTestCode",
              "testIsAppSupportedSelector",
              "testRootModal"
            ]
          }
        ]
      },
      "plugins": ["jest"]
    },
    {
      "files": [
        "**/design-system/**/*.{ts,tsx}",
        "**/playgrounds/**/*.{ts,tsx}",
        "**/devMode/**/*.{ts,tsx}",
        "**/debug/**/*.{ts,tsx}",
        "**/__mocks__/**/*.{ts,tsx}"
      ],
      "rules": {
        // Mocks, playgrounds and dev tooling legitimately use empty stubs.
        "no-empty-function": "off"
      }
    }
  ]
}
