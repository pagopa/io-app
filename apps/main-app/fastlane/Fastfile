# Customise this file, documentation can be found here:
# https://github.com/fastlane/fastlane/tree/master/fastlane/docs
# All available actions: https://docs.fastlane.tools/actions
# can also be listed using the `fastlane actions` command

# Change the syntax highlighting to Ruby
# All lines starting with a # are ignored when running `fastlane`

# If you want to automatically update fastlane if a new version is available:
# update_fastlane

# This is the minimum version number required.
# Update this, if you use features of a newer version
fastlane_version "2.233.1"

# Native projects are generated by `expo prebuild` (Continuous Native Generation)
# before running any build lane: run fastlane from apps/main-app, e.g.
#   bundle exec fastlane ios beta_testflight
#   bundle exec fastlane android alpha
# Actions run from apps/main-app, so native paths are prefixed with ios/ or android/.
# Canary builds are produced by prebuilding with APP_VARIANT=canary: there are
# no dedicated Xcode configurations or Gradle flavors.

IOS_WORKSPACE = "ios/IO.xcworkspace"
IOS_PROJECT = "ios/IO.xcodeproj"
IOS_OUTPUT_DIRECTORY = "ios"
CANARY_BUNDLE_ID = "it.pagopa.app.io.canary"
CANARY_MATCH_GIT_URL = "git@github.com:pagopa/IO-App-canary-certs.git"
ANDROID_PROJECT_DIR = "android"
CANARY_PACKAGE_NAME = "it.pagopa.io.app.canary"

platform :ios do
  before_all do
    setup_ci()
  end

  # Temporary disables automatic code signing so the matched profile is used.
  # @param profile_name [String] Name of the matched provisioning profile to sign the build with (e.g. "match AppStore it.pagopa.app.io").
  private_lane :disable_automatic_code_signing do |options|
    update_code_signing_settings(
      use_automatic_signing: false,
      path: IOS_PROJECT,
      team_id: "M2X5YQ4BJ7",
      targets: ["IO"],
      build_configurations: ["Release"],
      profile_name: options[:profile_name],
      code_sign_identity: "iPhone Distribution",
      sdk: "iphoneos*",
    )
  end

  # Generates the changelog from every commit since the last tag ending with
  # @param tag_suffix [String] Release type which can be a release candidate or a canary (e.g. "rc", "canary").
  private_lane :changelog_since_last_tag do |options|
    previous_tag = sh("git tag --sort=-taggerdate | grep \\\\-#{options[:tag_suffix]}\\\\. | sed -n '2 p' | tr -d '\n'")

    changelog_from_git_commits(
      tag_match_pattern: "*" + previous_tag + "*",
      pretty: "- %s",
      merge_commit_filtering: "exclude_merges"
    )
  end

  # Authenticates with the App Store Connect API key, returning it so it can
  # be reused by `sync_code_signing`/`pilot`. Requires `setup_ci` (run in
  # `before_all`) so the CI keychain is ready for credential access.
  private_lane :authenticate_app_store_connect do
    app_store_connect_api_key(
      key_id: "#{ENV['APP_STORE_API_KEY_ID']}",
      issuer_id: "#{ENV['APP_STORE_API_KEY_ISSUER_ID']}",
      key_filepath: "./fastlane/AuthKey_#{ENV['APP_STORE_API_KEY_ID']}.p8",
      duration: 1200,
    )
  end

  desc "Submit a new Beta Build to TestFlight"
  lane :beta_testflight do |options|

    # xCode 14.2, prevents altool to fail with error "Could not
    # determine the package’s bundle ID" during the "pilot" step
    # See https://github.com/fastlane/fastlane/issues/20741
    ENV['ITMSTRANSPORTER_FORCE_ITMS_PACKAGE_UPLOAD'] = 'false'

    # use the App Store API Key to authenticate
    api_key = authenticate_app_store_connect

    sync_code_signing(type: "appstore", api_key: api_key)

    # Install pods
    cocoapods(podfile: "ios/Podfile")

    # Temporary disables automatic code signing to avoid issues during build
    disable_automatic_code_signing(
      profile_name: "match AppStore it.pagopa.app.io"
    )

    # build the app
    gym(
      scheme: "IO",
      clean: true,
      export_method: "app-store",
      workspace: IOS_WORKSPACE,
      output_directory: IOS_OUTPUT_DIRECTORY,
      include_symbols: false
    )

    # generate the changelog based on last commits
    changelog = changelog_since_last_tag(tag_suffix: "rc")

    # upload to App store
    pilot(
      api_key: api_key,
      changelog: changelog,
      # max wait for App Store Connect processing (30 min)
      wait_processing_timeout_duration: 1800
    )
  end

  desc "Submit a new Canary Build to TestFlight (requires a prebuild with APP_VARIANT=canary)"
  lane :canary_testflight do |options|
    app_identifier = CANARY_BUNDLE_ID
    # xCode 14.2, prevents altool to fail with error "Could not
    # determine the package’s bundle ID" during the "pilot" step
    # See https://github.com/fastlane/fastlane/issues/20741
    ENV['ITMSTRANSPORTER_FORCE_ITMS_PACKAGE_UPLOAD'] = 'false'

    # use the App Store API Key to authenticate
    api_key = authenticate_app_store_connect

    sync_code_signing(
      type: "appstore",
      app_identifier: app_identifier,
      git_url: CANARY_MATCH_GIT_URL,
      api_key: api_key
    )

    # Install pods
    cocoapods(podfile: "ios/Podfile")

    # Temporary disables automatic code signing to avoid issues during build
    disable_automatic_code_signing(
      profile_name: "match AppStore #{app_identifier}"
    )

    # build the app
    gym(
      scheme: "IO",
      clean: true,
      export_method: "app-store",
      configuration: "Release",
      workspace: IOS_WORKSPACE,
      output_directory: IOS_OUTPUT_DIRECTORY,
      include_symbols: false
    )

    # generate the changelog based on last commits
    changelog = changelog_since_last_tag(tag_suffix: "canary")

    # upload to App store
    pilot(
      app_identifier: app_identifier,
      api_key: api_key,
      changelog: changelog,
      # max wait for App Store Connect processing (30 min)
      wait_processing_timeout_duration: 1800
    )
  end

  desc "Distribute previously uploaded beta to TestFlight, using GA"
  lane :distribute_beta_testflight do |options|

    # use the App Store API Key to authenticate
    api_key = authenticate_app_store_connect

    # upload to App store
    pilot(
      api_key: api_key,
      distribute_only: true,
      distribute_external: true,
      notify_external_testers: true,
      app_platform: "ios",
      groups: ["pagopa_beta_ios", "send_beta_ios", "ioproduct_beta_ios", "iomixpanel_beta_ios", "qa_beta_ios"],
      # max wait for App Store Connect processing (30 min)
      wait_processing_timeout_duration: 1800
    )
  end
end


platform :android do
  desc "Get current canary version code from Google Play"
  lane :current_canary_version_code do
    version_codes = google_play_track_version_codes(
      package_name: CANARY_PACKAGE_NAME,
      track: "internal"
    ) || []

    current_code = (version_codes.map(&:to_i).max || 0)

    if ENV["GITHUB_OUTPUT"]
      File.open(ENV["GITHUB_OUTPUT"], "a") do |file|
        file.puts("CURRENT_CANARY_VERSION_CODE=#{current_code}")
      end
    end

    UI.message("CURRENT_CANARY_VERSION_CODE=#{current_code}")
  end

  desc "Build the App in release mode"
  lane :build_release do
    # Ensure that your git status is not dirty
    #ensure_git_status_clean

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: ANDROID_PROJECT_DIR
    )
  end

  desc "Build the App in release mode for Canary (requires a prebuild with APP_VARIANT=canary)"
  lane :build_canary_release do
    build_release
  end

  desc "Build the App in release mode and deploy a new alpha version to the Google Play Store"
  lane :alpha do
    build_release

    # Generate the changelog from the last commit message
    changelog_from_git_commits(
      commits_count: 1
    )

    upload_to_play_store(
      track: "internal",
      skip_upload_screenshots: true,
      skip_upload_images: true
    )
  end

  desc "Build the App in release mode and deploy a new alpha version to the Google Play Store (Canary)"
  lane :alpha_canary do
    build_canary_release

    # Generate the changelog from the last commit message
    changelog_from_git_commits(
      commits_count: 1
    )

    upload_to_play_store(
      track: "internal",
      package_name: CANARY_PACKAGE_NAME,
      skip_upload_screenshots: true,
      skip_upload_images: true
    )
  end

  desc "Promote the internal version to alpha"
  lane :promote_internal_to_alpha do
    upload_to_play_store(track: "internal", track_promote_to: "alpha")
  end

  desc "Download universal APK file from Google Play"
  lane :download_apk do
    version_code = ENV['VERSION_CODE'].to_i
    download_universal_apk_from_google_play(
      package_name: "it.pagopa.io.app",
      destination: "io-app-universal.apk",
      version_code: version_code
    )
  end

  desc "Download universal APK file from Google Play (Canary)"
  lane :download_canary_apk do
    version_code = ENV['VERSION_CODE'].to_i
    download_universal_apk_from_google_play(
      package_name: CANARY_PACKAGE_NAME,
      destination: "io-app-canary-universal.apk",
      version_code: version_code
    )
  end
end

