{
  "name": "@io-app/expo-xstate-inspector",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/expo-xstate-inspector",
  "projectType": "library",
  "targets": {
    "tsc-noemit": {
      "inputs": [
        "typecheck",
        "{projectRoot}/tsconfig.web.json",
        "{projectRoot}/package.json",
        {
          "externalDependencies": ["react", "@types/react", "@types/react-dom"]
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @io-app/expo-xstate-inspector run tsc-noemit"
      }
    }
  }
}
